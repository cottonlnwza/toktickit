// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model User {
  id                           Int           @id @default(autoincrement())
  name                         String
  email                        String        @unique
  role                         UserRole
  isActive                     Boolean       @default(true)
  passwordHash                 String
  mustChangePassword           Boolean       @default(true)
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt
  requestedTickets             Ticket[]      @relation("RequestedTickets")
  ownedTickets                 Ticket[]      @relation("OwnedTickets")
  problemResolutionIndications Ticket[]      @relation("ProblemResolutionIndications")
  attachmentRemovals           Attachment[]  @relation("AttachmentRemovedBy")
  publicComments               PublicComment[]
  internalNotes                InternalNote[]
  sessions                     AuthSession[]
  createdActions               ActionTaken[]      @relation("ActionCreatedBy")
  assignedActions              ActionTaken[]      @relation("ActionAssignee")
  performedActions             ActionTaken[]      @relation("ActionPerformedBy")
  actionEvents                 ActionTakenEvent[] @relation("ActionEventActor")
  actionEventsFromAssignee     ActionTakenEvent[] @relation("ActionEventFromAssignee")
  actionEventsToAssignee       ActionTakenEvent[] @relation("ActionEventToAssignee")

  @@index([role, isActive])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
}

model Ticket {
  id                         Int               @id @default(autoincrement())
  ticketNumber               String            @unique
  clientRequestId            String            @unique
  requesterId                Int
  categoryId                 Int
  relatedSystemId            Int
  summary                    String
  description                String
  requestedPriority          RequestedPriority
  itPriority                 RequestedPriority
  currentStatus              TicketStatus      @default(NEW)
  ownerId                    Int?
  problemAppearsResolvedAt   DateTime?
  problemAppearsResolvedById Int?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  requester                  User              @relation("RequestedTickets", fields: [requesterId], references: [id], onDelete: Restrict)
  owner                      User?             @relation("OwnedTickets", fields: [ownerId], references: [id], onDelete: SetNull)
  problemAppearsResolvedBy   User?             @relation("ProblemResolutionIndications", fields: [problemAppearsResolvedById], references: [id], onDelete: SetNull)
  category                   Category          @relation(fields: [categoryId], references: [id])
  relatedSystem              RelatedSystem     @relation(fields: [relatedSystemId], references: [id])
  attachments                Attachment[]
  publicComments             PublicComment[]
  internalNotes              InternalNote[]
  actionsTaken               ActionTaken[]
  actionEvents               ActionTakenEvent[]
  version                    Int               @default(0)
  workflowCycle              Int               @default(1)
  resolvedAt                 DateTime?

  @@index([requesterId, updatedAt])
  @@index([requesterId, resolvedAt])
  @@index([requesterId, ticketNumber])
  @@index([requesterId, categoryId])
  @@index([requesterId, relatedSystemId])
  @@index([requesterId, requestedPriority])
  @@index([ownerId, updatedAt])
  @@index([requestedPriority, updatedAt])
  @@index([itPriority, updatedAt])
  @@index([currentStatus, updatedAt])
  @@index([updatedAt])
  @@index([categoryId, updatedAt])
  @@index([relatedSystemId, updatedAt])
}

model ActionTaken {
  id               Int          @id @default(autoincrement())
  ticketId         Int
  workflowCycle    Int
  clientRequestId  String       @unique
  createFingerprint String
  createdById      Int
  actionDescription String
  result           String?
  status           ActionStatus @default(PLANNED)
  assigneeId       Int
  performedById    Int?
  followUpRequired Boolean
  followUpNote     String?
  attachmentNotes  String?
  completedAt      DateTime?
  cancelledAt      DateTime?
  version          Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  ticket           Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  createdBy        User         @relation("ActionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignee         User         @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  performedBy      User?        @relation("ActionPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)
  events           ActionTakenEvent[]

  @@index([ticketId, workflowCycle, createdAt, id])
  @@index([assigneeId, status, updatedAt])
  @@index([performedById, updatedAt])
}

model ActionTakenEvent {
  id                 Int             @id @default(autoincrement())
  actionTakenId      Int
  ticketId           Int
  workflowCycle      Int
  eventType          ActionEventType
  actorId            Int
  fromStatus         ActionStatus?
  toStatus           ActionStatus?
  fromAssigneeId     Int?
  toAssigneeId       Int?
  actionVersion      Int
  ticketVersion      Int
  changedFields      Json?
  createdAt          DateTime        @default(now())
  actionTaken        ActionTaken     @relation(fields: [actionTakenId], references: [id], onDelete: Restrict)
  ticket             Ticket          @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor              User            @relation("ActionEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  fromAssignee       User?           @relation("ActionEventFromAssignee", fields: [fromAssigneeId], references: [id], onDelete: Restrict)
  toAssignee         User?           @relation("ActionEventToAssignee", fields: [toAssigneeId], references: [id], onDelete: Restrict)

  @@unique([actionTakenId, actionVersion])
  @@index([ticketId, workflowCycle, createdAt, id])
  @@index([actorId, createdAt])
}

model Attachment {
  id               Int      @id @default(autoincrement())
  ticketId         Int
  originalFilename String
  storedFilename   String   @unique
  mimeType         String
  sizeBytes        Int
  storagePath      String
  uploadedAt       DateTime @default(now())
  removedAt        DateTime?
  removedByUserId  Int?
  removalReason    String?
  ticket           Ticket   @relation(fields: [ticketId], references: [id])
  removedByUser    User?    @relation("AttachmentRemovedBy", fields: [removedByUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, removedAt])
}

model AuthSession {
  id            String   @id @default(uuid())
  userId        Int
  tokenHash     String   @unique
  csrfTokenHash String
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([authorId])
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionEventType {
  CREATED
  UPDATED
  STARTED
  COMPLETED
  CANCELLED
}
